{
  "name": "document-manager",
  "version": "0.1.0",
  "private": true,
  "description": "سامانه سازمانی مدیریت اسناد کارپردازی",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @dm/shared && npm run build -w @dm/report-engine",
    "build:shared": "npm run build -w @dm/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:phase5": "node scripts/verify-phase5.mjs",
    "docker:up": "docker compose -f infrastructure/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.dev.yml down",
    "docker:logs": "docker compose -f infrastructure/docker-compose.dev.yml logs -f"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.17.0",
    "fast-check": "^3.23.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8"
  }
}
