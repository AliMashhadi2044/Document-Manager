# نرمال‌سازی پایان خط: در مخزن همیشه LF
* text=auto eol=lf

# اسکریپت‌های ویندوزی باید CRLF بمانند
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# فایل‌های باینری
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.xlsx binary
