{
  "name": "@dm/shared",
  "version": "0.1.0",
  "private": true,
  "description": "هسته مشترک کلاینت و سرور: محاسبات مالی، تاریخ شمسی، شبا، شمارش‌ها",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node scripts/write-format-markers.mjs",
    "dev": "tsc -p tsconfig.cjs.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "jalaali-js": "1.2.8",
    "zod": "3.24.1"
  },
  "module": "./dist/esm/index.js"
}