# نمونه تنظیمات محیطی.
# این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید.
# هیچ secret واقعی هرگز در این فایل یا در مخزن قرار نمی‌گیرد.

# ───────────── محیط ─────────────
NODE_ENV=development
# پورت 3100 عمدی است: روی ویندوز بازه 2924-3023 رزرو شده و 3000 قابل bind نیست.
API_PORT=3100
WEB_PORT=5173
# مبدأ مجاز برای CORS در توسعه. در production رابط وب از همان origin سرو می‌شود.
WEB_ORIGIN=http://localhost:5173

# ───────────── PostgreSQL ─────────────
POSTGRES_USER=dm
POSTGRES_PASSWORD=
POSTGRES_DB=document_manager
POSTGRES_PORT=5433
# پورت 5433 عمدی است: 5432 ممکن است در اختیار PostgreSQL محلی باشد.
DATABASE_URL=postgresql://dm:CHANGE_ME@localhost:5433/document_manager?schema=public

# ───────────── object storage (MinIO سازگار با S3) ─────────────
MINIO_ROOT_USER=dm_minio
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dm-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ───────────── نشست و امنیت ─────────────
# کلید امضای کوکی نشست. حداقل ۳۲ نویسه تصادفی.
# تولید: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# انقضای مطلق نشست (دقیقه)
SESSION_ABSOLUTE_TTL_MINUTES=720
# انقضای بی‌تحرکی (دقیقه)
SESSION_IDLE_TTL_MINUTES=30
# قفل حساب پس از این تعداد تلاش ناموفق
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ───────────── فایل‌ها ─────────────
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_FILES_PER_DOCUMENT=30

# ───────────── گزارش‌ها ─────────────
PDF_RENDER_CONCURRENCY=2
PDF_RENDER_TIMEOUT_MS=60000
REPORT_OUTPUT_TTL_HOURS=48

# ───────────── log ─────────────
LOG_LEVEL=info
