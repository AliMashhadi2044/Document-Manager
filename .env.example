# نمونه تنظیمات محیطی.
# این فایل را به .env کپی کنید و مقادیر واقعی را بگذارید.
# هیچ secret واقعی هرگز در این فایل یا در مخزن قرار نمی‌گیرد.

# ───────────── محیط ─────────────
NODE_ENV=development
# پورت 3100 عمدی است: روی ویندوز بازه 2924-3023 رزرو شده و 3000 قابل bind نیست.
API_PORT=3100
WEB_PORT=5173
# مبدأ مجاز برای CORS در توسعه. در production رابط وب از همان origin سرو می‌شود.
WEB_ORIGIN=http://localhost:5173

# ───────────── PostgreSQL ─────────────
POSTGRES_USER=dm
POSTGRES_PASSWORD=
POSTGRES_DB=document_manager
POSTGRES_PORT=5433
# پورت 5433 عمدی است: 5432 ممکن است در اختیار PostgreSQL محلی باشد.
DATABASE_URL=postgresql://dm:CHANGE_ME@localhost:5433/document_manager?schema=public

# ───────────── object storage (MinIO سازگار با S3) ─────────────
MINIO_ROOT_USER=dm_minio
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dm-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ───────────── نشست و امنیت ─────────────
# کلید امضای کوکی نشست. حداقل ۳۲ نویسه تصادفی.
# تولید: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# انقضای مطلق نشست (دقیقه)
SESSION_ABSOLUTE_TTL_MINUTES=720
# انقضای بی‌تحرکی (دقیقه) — فقط مقدار **پیش‌فرض**.
# مدیر سامانه می‌تواند از «مدیریت کاربران ← امنیت نشست» عددی بگذارد که جای این
# را بگیرد؛ تا وقتی چیزی نگذاشته، همین مقدار حاکم است.
SESSION_IDLE_TTL_MINUTES=30
# قفل حساب پس از این تعداد تلاش ناموفق
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# نگهداشت داده (روز): اعلان خوانده‌شده و رویداد امنیتی. ردپای حسابرسی پاک نمی‌شود.
NOTIFICATION_RETENTION_DAYS=180
SECURITY_EVENT_RETENTION_DAYS=365
# سقف نرخ بر پایه نشانی شبکه: جدا از قفل حساب بالا، جلوی پخش کردن تلاش روی
# نام‌های کاربری مختلف از یک نشانی را می‌گیرد.
AUTH_RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_WINDOW_MINUTES=5
GENERAL_RATE_LIMIT_MAX=1200
# سرویس پشت proxy معکوس است؟ فقط در آن صورت true — وگرنه نشانی کاربر جعل‌پذیر می‌شود
# و سقف نرخ دور زده می‌شود.
TRUST_PROXY=false

# ───────────── فایل‌ها ─────────────
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_FILES_PER_DOCUMENT=30

# ───────────── گزارش‌ها ─────────────
PDF_RENDER_CONCURRENCY=2
PDF_RENDER_TIMEOUT_MS=60000
REPORT_OUTPUT_TTL_HOURS=48

# ───────────── log ─────────────
LOG_LEVEL=info

# مرز «خروجی حجیم» گزارش‌گیری: بیشتر از این تعداد ردیف به صف می‌رود و لینک موقت
# می‌دهد. روی ماشین توسعه عدد کوچکی بگذارید تا مسیر صف قابل آزمون باشد.
EXPORT_SYNC_ROW_LIMIT=2000

# عمر لینک دانلود خروجی صف‌شده (ساعت). پس از انقضا، فایل از فضای ذخیره‌سازی پاک می‌شود.
EXPORT_TTL_HOURS=24

# شمارنده کوئری هر درخواست در هدر X-Query-Count — ابزار تشخیصی برای اثبات نبودِ N+1
# (آزمون زنده فاز ۸). در production مجاز نیست و برنامه با آن بالا نمی‌آید.
EXPOSE_QUERY_COUNT=false
