{
  "name": "@dm/api",
  "version": "0.1.0",
  "private": true,
  "description": "سرویس NestJS سامانه مدیریت اسناد کارپردازی",
  "scripts": {
    "build": "nest build && tsc -p tsconfig.seed.json",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed/reference.ts",
    "db:seed:dev-users": "tsx --env-file-if-exists=.env prisma/seed/dev-users.ts",
    "db:seed:samples": "npm run build && node --env-file-if-exists=.env dist-seed/prisma/seed/sample-documents.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed/reference.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@dm/shared": "0.1.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@prisma/client": "6.1.0",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "8.0.0",
    "nestjs-pino": "^5.3.1",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "playwright-core": "^1.49.1",
    "prisma": "6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/multer": "^1.4.12",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "^4.23.15"
  }
}
