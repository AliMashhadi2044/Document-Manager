{
  "name": "@dm/api",
  "version": "0.1.0",
  "private": true,
  "description": "سرویس NestJS سامانه مدیریت اسناد کارپردازی",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed/reference.ts",
    "db:seed:dev-users": "tsx prisma/seed/dev-users.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed/reference.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.0",
    "@dm/shared": "0.1.0",
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "8.1.0",
    "@prisma/client": "6.1.0",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "8.0.0",
    "nestjs-pino": "4.2.0",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "playwright-core": "^1.49.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.15",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/multer": "^1.4.12",
    "@types/supertest": "6.0.2",
    "prisma": "6.1.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2"
  }
}
