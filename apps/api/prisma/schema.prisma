// مدل داده — فاز ۱: هویت، دسترسی، نشست، audit log و تنظیمات.
// موجودیت‌های دامنه (سند، فاکتور، فروشنده، …) در فازهای ۲ و ۳ افزوده می‌شوند.
// مرجع طراحی: docs/03-erd.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── هویت و دسترسی ───────────────────────────

model User {
  id           String  @id @default(uuid()) @db.Uuid
  username     String  @unique @db.VarChar(100)
  fullName     String  @map("full_name") @db.VarChar(200)
  passwordHash String  @map("password_hash") @db.Text
  isActive     Boolean @default(true) @map("is_active")

  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles            UserRole[]
  sessions         Session[]
  createdDocuments FinancialDocument[] @relation("DocumentCreatedBy")
  deletedDocuments FinancialDocument[] @relation("DocumentDeletedBy")
  createdInvoices  Invoice[]           @relation("InvoiceCreatedBy")
  securityEvents   SecurityEvent[]
  auditLogs        AuditLog[]
  preferences      UserPreferences?

  archivedDocuments    ArchiveMetadata[]             @relation("ArchiveCompletedBy")
  reportViews          ReportView[]                  @relation("ReportViewOwner")
  exportJobs           ExportJob[]                   @relation("ExportJobRequestedBy")
  uploadedAttachments  Attachment[]                  @relation("AttachmentUploadedBy")
  deletedAttachments   Attachment[]                  @relation("AttachmentDeletedBy")
  rotatedPages         AttachmentPageRotation[]      @relation("AttachmentRotationUpdatedBy")
  sharedReports        SharedReport[]                @relation("SharedReportSender")
  stadReportLines      InvoiceStadReportLine[]       @relation("StadReportLineUpdatedBy")
  createdFeedbacks     ReviewFeedback[]              @relation("FeedbackCreatedBy")
  reportDefinitions    ReportDefinition[]            @relation("ReportDefinitionCreatedBy")
  reportVersions       ReportVersion[]               @relation("ReportVersionCreatedBy")
  reportRuns           ReportRun[]                   @relation("ReportRunRequestedBy")
  productTypesSet      DocumentVendorProductType[]   @relation("ProductTypeSetBy")
  reportTitlesSet      InvoiceReportTitle[]          @relation("ReportTitleSetBy")
  feedbackReplies      ReviewFeedbackReply[]         @relation("FeedbackReplyBy")
  feedbackStatusEvents ReviewFeedbackStatusHistory[] @relation("FeedbackStatusActor")
  notifications        Notification[]                @relation("NotificationRecipient")
  paymentStatusSet     FinancialDocument[]           @relation("DocumentPaymentStatusBy")

  @@index([isActive])
  @@map("users")
}

model Role {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique @db.VarChar(50)
  titleFa  String  @map("title_fa") @db.VarChar(100)
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  key      String @unique @db.VarChar(100)
  groupKey String @map("group_key") @db.VarChar(50)
  titleFa  String @map("title_fa") @db.VarChar(200)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────── نشست ───────────────────────────
// ADR-0004: نشست سروری با کوکی HttpOnly. فقط «هش» توکن ذخیره می‌شود،
// تا افشای دیتابیس به سرقت نشست منجر نشود.

model Session {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @map("user_id") @db.Uuid
  tokenHash     String @unique @map("token_hash") @db.VarChar(128)
  csrfTokenHash String @map("csrf_token_hash") @db.VarChar(128)

  ip        String? @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(500)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model SecurityEvent {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid

  type      String  @db.VarChar(50)
  username  String? @db.VarChar(100)
  ip        String? @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(500)
  detail    Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@map("security_events")
}

// ─────────────────────────── حسابرسی ───────────────────────────

model AuditLog {
  id      String  @id @default(uuid()) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid

  action     String  @db.VarChar(100)
  entityType String  @map("entity_type") @db.VarChar(100)
  entityId   String? @map("entity_id") @db.Uuid
  documentId String? @map("document_id") @db.Uuid

  before        Json?
  after         Json?
  changedFields String[] @map("changed_fields")
  reason        String?  @db.Text

  ip      String? @db.VarChar(64)
  traceId String? @map("trace_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────── تنظیمات ───────────────────────────

model UserPreferences {
  userId String @id @map("user_id") @db.Uuid

  theme            String @default("system") @db.VarChar(20)
  primaryColor     String @default("default") @db.VarChar(30)
  tableDensity     String @default("comfortable") @db.VarChar(20)
  pageSize         Int    @default(25)
  columnVisibility Json?
  dashboard        Json?

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

// ─────────────────────────── ضد ثبت تکراری ───────────────────────────
// هدر Idempotency-Key برای عملیات حساس (ثبت نهایی، بازگشایی، بایگانی، آپلود).

model IdempotencyKey {
  key         String @id @db.VarChar(200)
  userId      String @map("user_id") @db.Uuid
  endpoint    String @db.VarChar(200)
  requestHash String @map("request_hash") @db.VarChar(128)

  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ═══════════════════════════ فاز ۲ — اطلاعات پایه ═══════════════════════════
// مرجع طراحی: docs/03-erd.md §۲
//
// قاعده مشترک همه این جداول: حذف نمی‌شوند، غیرفعال می‌شوند. رکورد غیرفعال سوابق
// تاریخی را خراب نمی‌کند، چون مقادیر نمایشی در فاکتور snapshot می‌شوند (فاز ۳).

enum PersonType {
  NATURAL // حقیقی
  LEGAL // حقوقی

  @@map("person_type")
}

enum BudgetCategoryKey {
  CURRENT // جاری
  CAPITAL // عمرانی

  @@map("budget_category_key")
}

enum InvoiceKind {
  NORMAL
  STAD
  UTILITY
  FUEL

  @@map("invoice_kind")
}

/// وضعیت پرداخت سند — بایگان تعیینش می‌کند، پس از بایگانی هم قابل تغییر است.
///
/// نبودِ مقدار (`NULL`) یعنی هنوز تعیین نشده، و این با «پرداخت کامل» یکی نیست:
/// داشبورد و گزارش‌ها هر سه حالت را جدا می‌شمارند.
enum PaymentSettlementStatus {
  FULLY_PAID // پرداخت کامل
  OUTSTANDING // نیازمندی — بخشی از مبلغ مانده است

  @@map("payment_settlement_status")
}

enum PaymentMethodKind {
  BENEFICIARY_ACCOUNT // حساب ذی‌نفع
  PETTY_CASH // کارپرداز یا تنخواه
  BILL // قبض
  SPLIT // بخشی به کارپرداز، بخشی به ذی‌نفع

  @@map("payment_method_kind")
}

// ─────────────────────── سازمان و امضاکنندگان ───────────────────────

model OrganizationSettings {
  id Int @id @default(1)

  name        String  @db.VarChar(300)
  addressLine String? @map("address_line") @db.Text
  postalCode  String? @map("postal_code") @db.VarChar(10)
  phone       String? @db.VarChar(30)
  fax         String? @db.VarChar(30)
  logoPath    String? @map("logo_path") @db.VarChar(500)

  /// سال مالی و سال شمسیِ پیش‌فرض برای فرم ایجاد سند.
  /// دامنه‌شان با CHECK در migration محدود شده است.
  defaultFiscalYear Int? @map("default_fiscal_year")
  defaultJalaliYear Int? @map("default_jalali_year")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // تک‌ردیفی بودن در migration با CHECK تضمین می‌شود.
  @@map("organization_settings")
}

model Signatory {
  id            String @id @default(uuid()) @db.Uuid
  fullName      String @map("full_name") @db.VarChar(200)
  positionTitle String @map("position_title") @db.VarChar(200)

  /// نقش در خروجی: GENERAL_MANAGER | PROCUREMENT_LEAD | OTHER
  roleKey   String  @map("role_key") @db.VarChar(50)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("signatories")
}

/// تنخواه‌دار — کسی که پرداخت به روش «کارپرداز / تنخواه» به حساب او انجام می‌شود.
///
/// چرا جدول جداست و نه `User`: تنخواه‌دار لزوماً کاربر سامانه نیست، و اطلاعاتی دارد
/// (صاحب حساب، بانک، شبا) که به حساب کاربری ربطی ندارد. گره زدنش به `users` یعنی
/// تعریف تنخواه‌دار در گرو ساختن حساب کاربری — که همان بن‌بستی بود که فرم فاکتور
/// با پیام «پس از افزودن مدیریت کاربران» اعلامش می‌کرد.
model PettyCashHolder {
  id            String  @id @default(uuid()) @db.Uuid
  fullName      String  @map("full_name") @db.VarChar(200)
  positionTitle String? @map("position_title") @db.VarChar(200)
  nationalId    String? @map("national_id") @db.VarChar(20)
  phone         String? @db.VarChar(30)

  /// نام صاحب حساب — همیشه با نام تنخواه‌دار یکی نیست (حساب همسر، حساب واحد).
  accountHolderName String? @map("account_holder_name") @db.VarChar(200)
  bankCode          String? @map("bank_code") @db.VarChar(3)
  iban              String? @db.VarChar(34)
  /// IR و ۲۴ رقم ASCII — همان صورت یکتاسازی که حساب فروشنده دارد.
  ibanNormalized    String? @map("iban_normalized") @db.VarChar(26)
  accountNumber     String? @map("account_number") @db.VarChar(50)

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")
  notes     String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bank     Bank?            @relation(fields: [bankCode], references: [code], onDelete: SetNull)
  payments InvoicePayment[]

  @@index([isActive, sortOrder])
  @@map("petty_cash_holders")
}

// ─────────────────────── خریدار ───────────────────────

model BuyerEntity {
  id         String     @id @default(uuid()) @db.Uuid
  personType PersonType @map("person_type")
  name       String     @db.VarChar(300)

  economicCode       String? @map("economic_code") @db.VarChar(30)
  registrationNumber String? @map("registration_number") @db.VarChar(30)
  nationalId         String? @map("national_id") @db.VarChar(20)

  addressLine String? @map("address_line") @db.Text
  postalCode  String? @map("postal_code") @db.VarChar(10)
  phone       String? @db.VarChar(30)
  fax         String? @db.VarChar(30)

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  /// مجموعه پیش‌فرض — در فرم ایجاد سند از پیش انتخاب می‌شود.
  /// یک ایندکس جزئی یکتا تضمین می‌کند حداکثر یک ردیف این علامت را دارد.
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  documents FinancialDocument[]

  @@index([isActive, sortOrder])
  @@map("buyer_entities")
}

// ─────────────────────── فروشنده ───────────────────────

model Vendor {
  id         String     @id @default(uuid()) @db.Uuid
  personType PersonType @map("person_type")
  name       String     @db.VarChar(300)

  /// نام نماینده — برای شخص حقوقی و اختیاری. همین مقدار در ستون «نام فروشنده»
  /// گزارش مالیات می‌نشیند (تصمیم Q15).
  representativeName String? @map("representative_name") @db.VarChar(200)

  economicCode       String? @map("economic_code") @db.VarChar(30)
  registrationNumber String? @map("registration_number") @db.VarChar(30)
  nationalId         String? @map("national_id") @db.VarChar(20)

  addressLine String? @map("address_line") @db.Text
  postalCode  String? @map("postal_code") @db.VarChar(10)
  phone       String? @db.VarChar(30)
  fax         String? @db.VarChar(30)

  isActive Boolean @default(true) @map("is_active")
  notes    String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bankAccounts VendorBankAccount[]
  invoices     Invoice[]

  documentProductTypes   DocumentVendorProductType[]
  productTypeSuggestions VendorProductTypeSuggestion[]

  @@index([isActive])
  @@index([name])
  @@map("vendors")
}

model Bank {
  /// کد سه‌رقمی بانک در شبا
  code     String  @id @db.VarChar(3)
  titleFa  String  @map("title_fa") @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  accounts         VendorBankAccount[]
  pettyCashHolders PettyCashHolder[]

  @@map("banks")
}

model VendorBankAccount {
  id       String @id @default(uuid()) @db.Uuid
  vendorId String @map("vendor_id") @db.Uuid

  /// مقدار واردشده کاربر، برای نمایش
  iban String @db.VarChar(34)

  /// IR و ۲۴ رقم ASCII — مبنای مقایسه و یکتایی
  ibanNormalized String  @unique @map("iban_normalized") @db.VarChar(26)
  bankCode       String? @map("bank_code") @db.VarChar(3)

  accountTitle String? @map("account_title") @db.VarChar(200)
  isDefault    Boolean @default(false) @map("is_default")
  isActive     Boolean @default(true) @map("is_active")
  notes        String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  bank            Bank?            @relation(fields: [bankCode], references: [code], onDelete: SetNull)
  invoicePayments InvoicePayment[]

  @@index([vendorId, isActive])
  @@map("vendor_bank_accounts")
}

// ─────────────────────── بودجه و انواع فاکتور ───────────────────────

model BudgetCategory {
  id        String            @id @default(uuid()) @db.Uuid
  key       BudgetCategoryKey @unique
  titleFa   String            @map("title_fa") @db.VarChar(100)
  sortOrder Int               @default(0) @map("sort_order")

  chapters BudgetChapter[]

  @@map("budget_categories")
}

model BudgetChapter {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  title      String @db.VarChar(200)

  /// کد فصل؛ ممکن است وجود نداشته باشد (مثل سوخت خودرو در گروه جاری)
  code        String? @db.VarChar(50)
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     BudgetCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  invoiceTypes ChapterInvoiceType[]
  invoices     Invoice[]

  @@unique([categoryId, title])
  @@index([categoryId, isActive, sortOrder])
  @@map("budget_chapters")
}

model InvoiceType {
  id  String @id @default(uuid()) @db.Uuid
  key String @unique @db.VarChar(50)

  /// خانواده ساختاری — تعیین می‌کند کدام فرم، schema و محاسبه‌گر به کار می‌رود.
  /// افزودن مقدار جدید نیاز به کد دارد؛ ساخت نوع فاکتور جدید نیاز ندارد.
  kind    InvoiceKind
  titleFa String      @map("title_fa") @db.VarChar(150)

  description            String? @db.Text
  defaultPaymentMethodId String? @map("default_payment_method_id") @db.Uuid

  /// توصیف محدود فیلدهای توسعه‌پذیر — نه کد و نه Zod دلخواه.
  customFieldSchema        Json? @map("custom_field_schema")
  customFieldSchemaVersion Int   @default(1) @map("custom_field_schema_version")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  defaultPaymentMethod PaymentMethod?             @relation(fields: [defaultPaymentMethodId], references: [id], onDelete: SetNull)
  chapters             ChapterInvoiceType[]
  taxRates             TaxRate[]
  invoices             Invoice[]
  paymentMethods       InvoiceTypePaymentMethod[]

  @@index([isActive, sortOrder])
  @@map("invoice_types")
}

model ChapterInvoiceType {
  chapterId     String  @map("chapter_id") @db.Uuid
  invoiceTypeId String  @map("invoice_type_id") @db.Uuid
  isDefault     Boolean @default(false) @map("is_default")
  sortOrder     Int     @default(0) @map("sort_order")

  chapter     BudgetChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  invoiceType InvoiceType   @relation(fields: [invoiceTypeId], references: [id], onDelete: Restrict)

  @@id([chapterId, invoiceTypeId])
  @@index([invoiceTypeId])
  @@map("chapter_invoice_types")
}

// ─────────────────────── روش پرداخت و نرخ مالیات ───────────────────────

model PaymentMethod {
  id      String            @id @default(uuid()) @db.Uuid
  key     String            @unique @db.VarChar(50)
  kind    PaymentMethodKind
  titleFa String            @map("title_fa") @db.VarChar(100)

  /// شناسه پرداخت در این روش الزامی است؟
  requiresPaymentIdentifier Boolean @default(false) @map("requires_payment_identifier")
  requiresBillIdentifier    Boolean @default(false) @map("requires_bill_identifier")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  invoiceTypes    InvoiceType[]
  invoicePayments InvoicePayment[]
  allowedFor      InvoiceTypePaymentMethod[]

  @@index([isActive, sortOrder])
  @@map("payment_methods")
}

/// روش‌های پرداخت **مجاز** برای یک نوع فاکتور.
///
/// قاعده: نبودِ هیچ ردیفی یعنی «همه روش‌های فعال مجازند». این عمدی است و نه
/// فراموشی — با قاعدهٔ وارونه (نبودِ ردیف یعنی هیچ‌کدام)، همین که جدول اضافه می‌شد،
/// ثبت فاکتور در کل سامانه می‌خوابید تا وقتی مدیر برای **هر** نوع فاکتور فهرست را
/// پر کند.
model InvoiceTypePaymentMethod {
  invoiceTypeId   String @map("invoice_type_id") @db.Uuid
  paymentMethodId String @map("payment_method_id") @db.Uuid
  sortOrder       Int    @default(0) @map("sort_order")

  invoiceType   InvoiceType   @relation(fields: [invoiceTypeId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@id([invoiceTypeId, paymentMethodId])
  @@index([paymentMethodId])
  @@map("invoice_type_payment_methods")
}

model TaxRate {
  id         String @id @default(uuid()) @db.Uuid
  fiscalYear Int    @map("fiscal_year")

  /// در صورت خالی بودن، نرخ پیش‌فرض همان سال است.
  invoiceTypeId String? @map("invoice_type_id") @db.Uuid

  /// نرخ به‌صورت basis point صحیح: ۱۰ درصد ⇒ 1000 (ADR-0003)
  rateBp Int     @map("rate_bp")
  notes  String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoiceType InvoiceType? @relation(fields: [invoiceTypeId], references: [id], onDelete: Cascade)

  // یکتایی با ایندکس جزئی در migration اعمال می‌شود، نه اینجا:
  // در PostgreSQL مقدار NULL در unique مرکب «متمایز» است، پس UNIQUE(fiscalYear,
  // invoiceTypeId) جلوی دو نرخ پیش‌فرض برای یک سال را نمی‌گیرد.
  @@index([fiscalYear])
  @@map("tax_rates")
}

model FiscalYear {
  year     Int     @id
  isActive Boolean @default(true) @map("is_active")

  /// سال بسته برای سند جدید قابل انتخاب نیست، ولی سوابق آن دست‌نخورده می‌ماند.
  isClosed Boolean @default(false) @map("is_closed")

  @@map("fiscal_years")
}

