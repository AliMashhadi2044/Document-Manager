// مدل داده — فاز ۱: هویت، دسترسی، نشست، audit log و تنظیمات.
// موجودیت‌های دامنه (سند، فاکتور، فروشنده، …) در فازهای ۲ و ۳ افزوده می‌شوند.
// مرجع طراحی: docs/03-erd.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── هویت و دسترسی ───────────────────────────

model User {
  id           String  @id @default(uuid()) @db.Uuid
  username     String  @unique @db.VarChar(100)
  fullName     String  @map("full_name") @db.VarChar(200)
  passwordHash String  @map("password_hash") @db.Text
  isActive     Boolean @default(true) @map("is_active")

  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles             UserRole[]
  sessions          Session[]
  createdDocuments  FinancialDocument[] @relation("DocumentCreatedBy")
  createdInvoices   Invoice[]           @relation("InvoiceCreatedBy")
  pettyCashPayments InvoicePayment[]    @relation("PettyCashHolder")
  securityEvents    SecurityEvent[]
  auditLogs         AuditLog[]
  preferences       UserPreferences?

  archivedDocuments    ArchiveMetadata[]             @relation("ArchiveCompletedBy")
  uploadedAttachments  Attachment[]                  @relation("AttachmentUploadedBy")
  deletedAttachments   Attachment[]                  @relation("AttachmentDeletedBy")
  createdFeedbacks     ReviewFeedback[]              @relation("FeedbackCreatedBy")
  reportDefinitions    ReportDefinition[]            @relation("ReportDefinitionCreatedBy")
  reportVersions       ReportVersion[]               @relation("ReportVersionCreatedBy")
  reportRuns           ReportRun[]                   @relation("ReportRunRequestedBy")
  productTypesSet      DocumentVendorProductType[]   @relation("ProductTypeSetBy")
  feedbackReplies      ReviewFeedbackReply[]         @relation("FeedbackReplyBy")
  feedbackStatusEvents ReviewFeedbackStatusHistory[] @relation("FeedbackStatusActor")
  notifications        Notification[]                @relation("NotificationRecipient")

  @@index([isActive])
  @@map("users")
}

model Role {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique @db.VarChar(50)
  titleFa  String  @map("title_fa") @db.VarChar(100)
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  key      String @unique @db.VarChar(100)
  groupKey String @map("group_key") @db.VarChar(50)
  titleFa  String @map("title_fa") @db.VarChar(200)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────── نشست ───────────────────────────
// ADR-0004: نشست سروری با کوکی HttpOnly. فقط «هش» توکن ذخیره می‌شود،
// تا افشای دیتابیس به سرقت نشست منجر نشود.

model Session {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @map("user_id") @db.Uuid
  tokenHash     String @unique @map("token_hash") @db.VarChar(128)
  csrfTokenHash String @map("csrf_token_hash") @db.VarChar(128)

  ip        String? @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(500)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model SecurityEvent {
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid

  type      String  @db.VarChar(50)
  username  String? @db.VarChar(100)
  ip        String? @db.VarChar(64)
  userAgent String? @map("user_agent") @db.VarChar(500)
  detail    Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@map("security_events")
}

// ─────────────────────────── حسابرسی ───────────────────────────

model AuditLog {
  id      String  @id @default(uuid()) @db.Uuid
  actorId String? @map("actor_id") @db.Uuid

  action     String  @db.VarChar(100)
  entityType String  @map("entity_type") @db.VarChar(100)
  entityId   String? @map("entity_id") @db.Uuid
  documentId String? @map("document_id") @db.Uuid

  before        Json?
  after         Json?
  changedFields String[] @map("changed_fields")
  reason        String?  @db.Text

  ip      String? @db.VarChar(64)
  traceId String? @map("trace_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────── تنظیمات ───────────────────────────

model UserPreferences {
  userId String @id @map("user_id") @db.Uuid

  theme            String @default("system") @db.VarChar(20)
  primaryColor     String @default("default") @db.VarChar(30)
  tableDensity     String @default("comfortable") @db.VarChar(20)
  pageSize         Int    @default(25)
  columnVisibility Json?
  dashboard        Json?

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model SystemSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

// ─────────────────────────── ضد ثبت تکراری ───────────────────────────
// هدر Idempotency-Key برای عملیات حساس (ثبت نهایی، بازگشایی، بایگانی، آپلود).

model IdempotencyKey {
  key         String @id @db.VarChar(200)
  userId      String @map("user_id") @db.Uuid
  endpoint    String @db.VarChar(200)
  requestHash String @map("request_hash") @db.VarChar(128)

  responseStatus Int?  @map("response_status")
  responseBody   Json? @map("response_body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ═══════════════════════════ فاز ۲ — اطلاعات پایه ═══════════════════════════
// مرجع طراحی: docs/03-erd.md §۲
//
// قاعده مشترک همه این جداول: حذف نمی‌شوند، غیرفعال می‌شوند. رکورد غیرفعال سوابق
// تاریخی را خراب نمی‌کند، چون مقادیر نمایشی در فاکتور snapshot می‌شوند (فاز ۳).

enum PersonType {
  NATURAL // حقیقی
  LEGAL // حقوقی

  @@map("person_type")
}

enum BudgetCategoryKey {
  CURRENT // جاری
  CAPITAL // عمرانی

  @@map("budget_category_key")
}

enum InvoiceKind {
  NORMAL
  STAD
  UTILITY
  FUEL

  @@map("invoice_kind")
}

enum PaymentMethodKind {
  BENEFICIARY_ACCOUNT // حساب ذی‌نفع
  PETTY_CASH // کارپرداز یا تنخواه
  BILL // قبض

  @@map("payment_method_kind")
}

// ─────────────────────── سازمان و امضاکنندگان ───────────────────────

model OrganizationSettings {
  id Int @id @default(1)

  name        String  @db.VarChar(300)
  addressLine String? @map("address_line") @db.Text
  postalCode  String? @map("postal_code") @db.VarChar(10)
  phone       String? @db.VarChar(30)
  fax         String? @db.VarChar(30)
  logoPath    String? @map("logo_path") @db.VarChar(500)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // تک‌ردیفی بودن در migration با CHECK تضمین می‌شود.
  @@map("organization_settings")
}

model Signatory {
  id            String @id @default(uuid()) @db.Uuid
  fullName      String @map("full_name") @db.VarChar(200)
  positionTitle String @map("position_title") @db.VarChar(200)

  /// نقش در خروجی: GENERAL_MANAGER | PROCUREMENT_LEAD | OTHER
  roleKey   String  @map("role_key") @db.VarChar(50)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("signatories")
}

// ─────────────────────── خریدار ───────────────────────

model BuyerEntity {
  id         String     @id @default(uuid()) @db.Uuid
  personType PersonType @map("person_type")
  name       String     @db.VarChar(300)

  economicCode       String? @map("economic_code") @db.VarChar(30)
  registrationNumber String? @map("registration_number") @db.VarChar(30)
  nationalId         String? @map("national_id") @db.VarChar(20)

  addressLine String? @map("address_line") @db.Text
  postalCode  String? @map("postal_code") @db.VarChar(10)
  phone       String? @db.VarChar(30)
  fax         String? @db.VarChar(30)

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  documents FinancialDocument[]

  @@index([isActive, sortOrder])
  @@map("buyer_entities")
}

// ─────────────────────── فروشنده ───────────────────────

model Vendor {
  id         String     @id @default(uuid()) @db.Uuid
  personType PersonType @map("person_type")
  name       String     @db.VarChar(300)

  /// نام نماینده — برای شخص حقوقی و اختیاری. همین مقدار در ستون «نام فروشنده»
  /// گزارش مالیات می‌نشیند (تصمیم Q15).
  representativeName String? @map("representative_name") @db.VarChar(200)

  economicCode       String? @map("economic_code") @db.VarChar(30)
  registrationNumber String? @map("registration_number") @db.VarChar(30)
  nationalId         String? @map("national_id") @db.VarChar(20)

  addressLine String? @map("address_line") @db.Text
  postalCode  String? @map("postal_code") @db.VarChar(10)
  phone       String? @db.VarChar(30)
  fax         String? @db.VarChar(30)

  isActive Boolean @default(true) @map("is_active")
  notes    String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  bankAccounts VendorBankAccount[]
  invoices     Invoice[]

  documentProductTypes   DocumentVendorProductType[]
  productTypeSuggestions VendorProductTypeSuggestion[]

  @@index([isActive])
  @@index([name])
  @@map("vendors")
}

model Bank {
  /// کد سه‌رقمی بانک در شبا
  code     String  @id @db.VarChar(3)
  titleFa  String  @map("title_fa") @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  accounts VendorBankAccount[]

  @@map("banks")
}

model VendorBankAccount {
  id       String @id @default(uuid()) @db.Uuid
  vendorId String @map("vendor_id") @db.Uuid

  /// مقدار واردشده کاربر، برای نمایش
  iban String @db.VarChar(34)

  /// IR و ۲۴ رقم ASCII — مبنای مقایسه و یکتایی
  ibanNormalized String  @unique @map("iban_normalized") @db.VarChar(26)
  bankCode       String? @map("bank_code") @db.VarChar(3)

  accountTitle String? @map("account_title") @db.VarChar(200)
  isDefault    Boolean @default(false) @map("is_default")
  isActive     Boolean @default(true) @map("is_active")
  notes        String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  bank            Bank?            @relation(fields: [bankCode], references: [code], onDelete: SetNull)
  invoicePayments InvoicePayment[]

  @@index([vendorId, isActive])
  @@map("vendor_bank_accounts")
}

// ─────────────────────── بودجه و انواع فاکتور ───────────────────────

model BudgetCategory {
  id        String            @id @default(uuid()) @db.Uuid
  key       BudgetCategoryKey @unique
  titleFa   String            @map("title_fa") @db.VarChar(100)
  sortOrder Int               @default(0) @map("sort_order")

  chapters BudgetChapter[]

  @@map("budget_categories")
}

model BudgetChapter {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  title      String @db.VarChar(200)

  /// کد فصل؛ ممکن است وجود نداشته باشد (مثل سوخت خودرو در گروه جاری)
  code        String? @db.VarChar(50)
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     BudgetCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  invoiceTypes ChapterInvoiceType[]
  invoices     Invoice[]

  @@unique([categoryId, title])
  @@index([categoryId, isActive, sortOrder])
  @@map("budget_chapters")
}

model InvoiceType {
  id  String @id @default(uuid()) @db.Uuid
  key String @unique @db.VarChar(50)

  /// خانواده ساختاری — تعیین می‌کند کدام فرم، schema و محاسبه‌گر به کار می‌رود.
  /// افزودن مقدار جدید نیاز به کد دارد؛ ساخت نوع فاکتور جدید نیاز ندارد.
  kind    InvoiceKind
  titleFa String      @map("title_fa") @db.VarChar(150)

  description            String? @db.Text
  defaultPaymentMethodId String? @map("default_payment_method_id") @db.Uuid

  /// توصیف محدود فیلدهای توسعه‌پذیر — نه کد و نه Zod دلخواه.
  customFieldSchema        Json? @map("custom_field_schema")
  customFieldSchemaVersion Int   @default(1) @map("custom_field_schema_version")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  defaultPaymentMethod PaymentMethod?       @relation(fields: [defaultPaymentMethodId], references: [id], onDelete: SetNull)
  chapters             ChapterInvoiceType[]
  taxRates             TaxRate[]
  invoices             Invoice[]

  @@index([isActive, sortOrder])
  @@map("invoice_types")
}

model ChapterInvoiceType {
  chapterId     String  @map("chapter_id") @db.Uuid
  invoiceTypeId String  @map("invoice_type_id") @db.Uuid
  isDefault     Boolean @default(false) @map("is_default")
  sortOrder     Int     @default(0) @map("sort_order")

  chapter     BudgetChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  invoiceType InvoiceType   @relation(fields: [invoiceTypeId], references: [id], onDelete: Restrict)

  @@id([chapterId, invoiceTypeId])
  @@index([invoiceTypeId])
  @@map("chapter_invoice_types")
}

// ─────────────────────── روش پرداخت و نرخ مالیات ───────────────────────

model PaymentMethod {
  id      String            @id @default(uuid()) @db.Uuid
  key     String            @unique @db.VarChar(50)
  kind    PaymentMethodKind
  titleFa String            @map("title_fa") @db.VarChar(100)

  /// شناسه پرداخت در این روش الزامی است؟
  requiresPaymentIdentifier Boolean @default(false) @map("requires_payment_identifier")
  requiresBillIdentifier    Boolean @default(false) @map("requires_bill_identifier")

  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  invoiceTypes    InvoiceType[]
  invoicePayments InvoicePayment[]

  @@index([isActive, sortOrder])
  @@map("payment_methods")
}

model TaxRate {
  id         String @id @default(uuid()) @db.Uuid
  fiscalYear Int    @map("fiscal_year")

  /// در صورت خالی بودن، نرخ پیش‌فرض همان سال است.
  invoiceTypeId String? @map("invoice_type_id") @db.Uuid

  /// نرخ به‌صورت basis point صحیح: ۱۰ درصد ⇒ 1000 (ADR-0003)
  rateBp Int     @map("rate_bp")
  notes  String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoiceType InvoiceType? @relation(fields: [invoiceTypeId], references: [id], onDelete: Cascade)

  // یکتایی با ایندکس جزئی در migration اعمال می‌شود، نه اینجا:
  // در PostgreSQL مقدار NULL در unique مرکب «متمایز» است، پس UNIQUE(fiscalYear,
  // invoiceTypeId) جلوی دو نرخ پیش‌فرض برای یک سال را نمی‌گیرد.
  @@index([fiscalYear])
  @@map("tax_rates")
}

model FiscalYear {
  year     Int     @id
  isActive Boolean @default(true) @map("is_active")

  /// سال بسته برای سند جدید قابل انتخاب نیست، ولی سوابق آن دست‌نخورده می‌ماند.
  isClosed Boolean @default(false) @map("is_closed")

  @@map("fiscal_years")
}

// ─────────────────────── نواحی، مدارس، انشعاب ───────────────────────

model District {
  id        String  @id @default(uuid()) @db.Uuid
  title     String  @unique @db.VarChar(200)
  code      String? @db.VarChar(50)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  schools         School[]
  utilityInvoices InvoiceUtilityDetail[]

  @@index([isActive, sortOrder])
  @@map("districts")
}

model School {
  id         String  @id @default(uuid()) @db.Uuid
  districtId String  @map("district_id") @db.Uuid
  title      String  @db.VarChar(200)
  code       String? @db.VarChar(50)
  isActive   Boolean @default(true) @map("is_active")
  sortOrder  Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  utilityInvoices InvoiceUtilityDetail[]

  @@unique([districtId, title])
  @@index([isActive])
  @@map("schools")
}

model UtilityType {
  id        String  @id @default(uuid()) @db.Uuid
  title     String  @unique @db.VarChar(150)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  utilityInvoices InvoiceUtilityDetail[]

  @@index([isActive, sortOrder])
  @@map("utility_types")
}

// ─────────────────────── خودرو و سوخت ───────────────────────

model VehicleType {
  id        String  @id @default(uuid()) @db.Uuid
  title     String  @unique @db.VarChar(150)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicles     Vehicle[]
  fuelInvoices InvoiceFuelDetail[]

  @@index([isActive, sortOrder])
  @@map("vehicle_types")
}

model Vehicle {
  id            String @id @default(uuid()) @db.Uuid
  vehicleTypeId String @map("vehicle_type_id") @db.Uuid

  /// پلاک به‌صورت واردشده، برای نمایش
  plateNumber String @map("plate_number") @db.VarChar(50)

  /// صورت نرمال‌شده بدون فاصله و جداکننده — مبنای یکتایی
  plateNormalized String  @unique @map("plate_normalized") @db.VarChar(50)
  isActive        Boolean @default(true) @map("is_active")
  notes           String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicleType  VehicleType         @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  fuelInvoices InvoiceFuelDetail[]

  @@index([vehicleTypeId, isActive])
  @@map("vehicles")
}

model FuelType {
  id        String  @id @default(uuid()) @db.Uuid
  title     String  @unique @db.VarChar(100)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  fuelInvoices InvoiceFuelDetail[]

  @@index([isActive, sortOrder])
  @@map("fuel_types")
}

// ─────────────────────── ستاد، کالا، واحد ───────────────────────

model StadRequestType {
  id        String  @id @default(uuid()) @db.Uuid
  title     String  @unique @db.VarChar(150)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stadDocuments DocumentStadMetadata[]

  @@index([isActive, sortOrder])
  @@map("stad_request_types")
}

model ProductType {
  id        String  @id @default(uuid()) @db.Uuid
  title     String  @unique @db.VarChar(200)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  documentVendors DocumentVendorProductType[]
  suggestions     VendorProductTypeSuggestion[]

  @@index([isActive, sortOrder])
  @@map("product_types")
}

model MeasurementUnit {
  id        String  @id @default(uuid()) @db.Uuid
  title     String  @unique @db.VarChar(50)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoiceItems InvoiceItem[]

  @@index([isActive, sortOrder])
  @@map("measurement_units")
}

// ═══════════════════════ فاز ۳ — سند و فاکتور ═══════════════════════
// مرجع: docs/03-erd.md §۳ و docs/08-financial-rules.md
//
// سه قاعده‌ای که این بخش را از یک CRUD ساده جدا می‌کند:
//  ۱. تمام مبالغ BigInt ریال صحیح‌اند؛ هرگز Decimal یا Float (ADR-0003).
//  ۲. اطلاعات فروشنده و خریدار در زمان ثبت snapshot می‌شوند تا تغییر اطلاعات پایه
//     اسناد گذشته را عوض نکند (ADR-0005، ریسک R6).
//  ۳. سیاست گرد کردن روی خود سند قفل می‌شود، نه خوانده‌شده از تنظیمات زنده (ADR-0012).

enum DocumentType {
  NORMAL
  STAD

  @@map("document_type")
}

enum DocumentStatus {
  DRAFT // پیش‌نویس
  FINALIZED // ثبت‌شده
  PENDING_ARCHIVE // در انتظار بایگانی
  ARCHIVED // بایگانی‌شده
  NEEDS_REVISION // نیازمند اصلاح
  REOPENED // بازگشایی‌شده

  @@map("document_status")
}

enum TaxMode {
  PERCENT // ورود نرخ درصدی
  AMOUNT // ورود مستقیم مبلغ

  @@map("tax_mode")
}

enum RevisionTrigger {
  FINALIZE
  REOPEN
  ARCHIVE
  CORRECTION

  @@map("revision_trigger")
}

// ─────────────────────── snapshotهای تغییرناپذیر ───────────────────────
// جدول ساختارمند، نه JSON: گزارش مالیات باید روی همین اطلاعات تاریخی گروه‌بندی و
// مرتب‌سازی کند و JSON بی‌schema این کوئری‌ها را شکننده می‌کرد (ADR-0005).
//
// هر فاکتور ردیف snapshot اختصاصی خودش را دارد؛ به اشتراک گذاشته نمی‌شود تا هیچ
// مسیری برای بازنویسی ناخواسته اطلاعات تاریخی باز نماند.

model VendorSnapshot {
  id String @id @default(uuid()) @db.Uuid

  /// ارجاع به رکورد زنده — برای گزارش‌گیری و پیشنهاد نوع کالا. اختیاری است چون
  /// حذف فروشنده نباید snapshot تاریخی را از بین ببرد.
  vendorId String? @map("vendor_id") @db.Uuid

  personType         PersonType @map("person_type")
  name               String     @db.VarChar(300)
  representativeName String?    @map("representative_name") @db.VarChar(200)
  economicCode       String?    @map("economic_code") @db.VarChar(30)
  registrationNumber String?    @map("registration_number") @db.VarChar(30)
  nationalId         String?    @map("national_id") @db.VarChar(20)
  addressLine        String?    @map("address_line") @db.Text
  postalCode         String?    @map("postal_code") @db.VarChar(10)
  phone              String?    @db.VarChar(30)
  fax                String?    @db.VarChar(30)

  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)

  invoices Invoice[]

  @@index([vendorId])
  @@map("vendor_snapshots")
}

model BuyerSnapshot {
  id            String  @id @default(uuid()) @db.Uuid
  buyerEntityId String? @map("buyer_entity_id") @db.Uuid

  personType         PersonType @map("person_type")
  name               String     @db.VarChar(300)
  economicCode       String?    @map("economic_code") @db.VarChar(30)
  registrationNumber String?    @map("registration_number") @db.VarChar(30)
  nationalId         String?    @map("national_id") @db.VarChar(20)
  addressLine        String?    @map("address_line") @db.Text
  postalCode         String?    @map("postal_code") @db.VarChar(10)
  phone              String?    @db.VarChar(30)
  fax                String?    @db.VarChar(30)

  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)

  documents FinancialDocument[]
  invoices  Invoice[]

  @@index([buyerEntityId])
  @@map("buyer_snapshots")
}

// ─────────────────────── سند مالی ───────────────────────

model FinancialDocument {
  id    String       @id @default(uuid()) @db.Uuid
  title String       @db.VarChar(500)
  type  DocumentType

  /// سال مالی و سال شمسی دو فیلد **مستقل**اند (§۴ پرامپت).
  fiscalYear Int @map("fiscal_year")
  jalaliYear Int @map("jalali_year")

  status DocumentStatus @default(DRAFT)

  buyerEntityId   String @map("buyer_entity_id") @db.Uuid
  buyerSnapshotId String @map("buyer_snapshot_id") @db.Uuid

  /// شماره و تاریخ سند را **بایگانی** وارد می‌کند (فاز ۵).
  /// یکتایی در هر سال مالی با ایندکس جزئی در migration اعمال می‌شود (تصمیم Q5).
  documentNumber String?   @map("document_number") @db.VarChar(50)
  documentDate   DateTime? @map("document_date") @db.Date

  /// snapshot سیاست گرد کردن؛ پس از ثبت نهایی قفل است (ADR-0012، ریسک R14).
  roundingPolicy Json @map("rounding_policy")

  /// جمع‌های ذخیره‌شده — فقط لایه financial داخل همان تراکنش می‌نویسدشان.
  totalGross    BigInt @default(0) @map("total_gross") @db.BigInt
  totalDiscount BigInt @default(0) @map("total_discount") @db.BigInt
  totalNet      BigInt @default(0) @map("total_net") @db.BigInt
  totalTax      BigInt @default(0) @map("total_tax") @db.BigInt
  totalAmount   BigInt @default(0) @map("total_amount") @db.BigInt

  /// شاخص «دارای بازخورد» — وضعیت سند نیست (تصمیم B12).
  openFeedbackCount Int @default(0) @map("open_feedback_count")

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  finalizedAt   DateTime? @map("finalized_at") @db.Timestamptz(3)
  finalizedById String?   @map("finalized_by_id") @db.Uuid
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)

  buyerEntity   BuyerEntity   @relation(fields: [buyerEntityId], references: [id], onDelete: Restrict)
  buyerSnapshot BuyerSnapshot @relation(fields: [buyerSnapshotId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  stadMetadata DocumentStadMetadata?
  invoices     Invoice[]
  revisions    DocumentRevision[]
  transitions  DocumentStatusTransition[]

  archiveMetadata ArchiveMetadata?
  attachments     Attachment[]
  feedbacks       ReviewFeedback[]
  notifications   Notification[]
  reportRuns      ReportRun[]
  vendorProductTypes DocumentVendorProductType[]

  /// لازم برای FK ترکیبی از invoices — ستون فقرات محدودیت یک فاکتور ستاد (ADR-0006).
  @@unique([id, type])
  @@index([fiscalYear, status, type, createdAt])
  @@index([status, createdAt])
  @@map("financial_documents")
}

model DocumentStadMetadata {
  documentId String @id @map("document_id") @db.Uuid

  /// سقف ۵۰ نویسه طبق §۹ پرامپت.
  needNumber     String  @map("need_number") @db.VarChar(50)
  workflowNumber String  @map("workflow_number") @db.VarChar(100)
  requestNumber  String  @map("request_number") @db.VarChar(100)
  requestTypeId  String? @map("request_type_id") @db.Uuid
  notes          String? @db.Text

  document    FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestType StadRequestType?  @relation(fields: [requestTypeId], references: [id], onDelete: SetNull)

  @@map("document_stad_metadata")
}

/// نسخه کامل سند برای بازسازی وضعیت گذشته (ADR-0009).
/// تنها جایی که JSON بی‌ساختار پذیرفته است، چون هدفش بازسازی است نه کوئری.
model DocumentRevision {
  id            String          @id @default(uuid()) @db.Uuid
  documentId    String          @map("document_id") @db.Uuid
  revisionNo    Int             @map("revision_no")
  schemaVersion Int             @default(1) @map("schema_version")
  trigger       RevisionTrigger
  snapshot      Json
  reason        String?         @db.Text

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, revisionNo])
  @@index([documentId, createdAt])
  @@map("document_revisions")
}

model DocumentStatusTransition {
  id         String         @id @default(uuid()) @db.Uuid
  documentId String         @map("document_id") @db.Uuid
  fromStatus DocumentStatus @map("from_status")
  toStatus   DocumentStatus @map("to_status")
  action     String         @db.VarChar(50)
  reason     String?        @db.Text

  actorId   String   @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("document_status_transitions")
}

// ─────────────────────── فاکتور ───────────────────────

model Invoice {
  id         String @id @default(uuid()) @db.Uuid
  documentId String @map("document_id") @db.Uuid

  /// نسخه denormal نوع سند. **فقط** با FK ترکیبی نگهداری می‌شود و کد هرگز مستقل
  /// تغییرش نمی‌دهد؛ همین ستون است که ایندکس جزئی «یک فاکتور ستاد» را ممکن می‌کند.
  documentType DocumentType @map("document_type")

  invoiceTypeId String      @map("invoice_type_id") @db.Uuid
  /// خانواده ساختاری، denormal برای رندر و گزارش بدون وابستگی به پیکربندی فعلی.
  invoiceKind   InvoiceKind @map("invoice_kind")

  chapterId            String  @map("chapter_id") @db.Uuid
  chapterCodeSnapshot  String? @map("chapter_code_snapshot") @db.VarChar(50)
  chapterTitleSnapshot String  @map("chapter_title_snapshot") @db.VarChar(200)

  /// فروشنده روی **همه** انواع فاکتور در دسترس و اختیاری است (تصمیم Q1).
  vendorId         String? @map("vendor_id") @db.Uuid
  vendorSnapshotId String? @map("vendor_snapshot_id") @db.Uuid
  buyerSnapshotId  String  @map("buyer_snapshot_id") @db.Uuid

  invoiceNumber String?  @map("invoice_number") @db.VarChar(100)
  /// تاریخ صورتحساب — مبنای مرتب‌سازی فهرست و قاعده تاریخ در گزارش مالیات.
  invoiceDate   DateTime @map("invoice_date") @db.Date

  taxMode   TaxMode @map("tax_mode")
  /// basis point صحیح؛ فقط در حالت PERCENT مقدار دارد.
  taxRateBp Int?    @map("tax_rate_bp")

  grossAmount    BigInt @map("gross_amount") @db.BigInt
  discountAmount BigInt @default(0) @map("discount_amount") @db.BigInt
  netAmount      BigInt @map("net_amount") @db.BigInt
  taxAmount      BigInt @default(0) @map("tax_amount") @db.BigInt
  totalAmount    BigInt @map("total_amount") @db.BigInt

  customFields              Json?   @map("custom_fields")
  customFieldsSchemaVersion Int     @default(1) @map("custom_fields_schema_version")
  notes                     String? @db.Text

  sortIndex   Int      @default(0) @map("sort_index")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  document       FinancialDocument @relation(fields: [documentId, documentType], references: [id, type], onDelete: Cascade, onUpdate: Cascade)
  invoiceType    InvoiceType       @relation(fields: [invoiceTypeId], references: [id], onDelete: Restrict)
  chapter        BudgetChapter     @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  vendor         Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorSnapshot VendorSnapshot?   @relation(fields: [vendorSnapshotId], references: [id], onDelete: Restrict)
  buyerSnapshot  BuyerSnapshot     @relation(fields: [buyerSnapshotId], references: [id], onDelete: Restrict)
  createdBy      User              @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items   InvoiceItem[]
  payment InvoicePayment?

  /// جزئیات اختصاصی — هر فاکتور حداکثر یکی از این‌ها را دارد، مطابق `invoiceKind`.
  utilityDetail InvoiceUtilityDetail?
  fuelDetail    InvoiceFuelDetail?

  feedbacks ReviewFeedback[]

  /// مرجع FK ترکیبی جدول‌های جزئیات اختصاصی: جزئیات انشعابات فقط به فاکتوری با
  /// `invoice_kind = 'UTILITY'` می‌چسبد و جزئیات سوخت فقط به `'FUEL'`. این قید را
  /// دیتابیس نگه می‌دارد، نه کد.
  @@unique([id, invoiceKind])
  /// مرتب‌سازی پیش‌فرض فهرست فاکتورها: تاریخ صعودی با ترتیب ثانویه پایدار (§۹).
  @@index([documentId, invoiceDate, id])
  @@index([vendorId, invoiceDate])
  @@index([documentId, vendorId])
  @@map("invoices")
}

model InvoiceItem {
  id        String @id @default(uuid()) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  rowNo     Int    @map("row_no")

  productCode String? @map("product_code") @db.VarChar(100)
  description String  @db.VarChar(1000)

  /// مقدار با سه رقم اعشار (تصمیم Q11).
  quantity  Decimal @db.Decimal(18, 3)
  unitId    String? @map("unit_id") @db.Uuid
  unitPrice BigInt  @map("unit_price") @db.BigInt

  grossAmount    BigInt @map("gross_amount") @db.BigInt
  discountAmount BigInt @default(0) @map("discount_amount") @db.BigInt
  netAmount      BigInt @map("net_amount") @db.BigInt

  taxMode   TaxMode @map("tax_mode")
  taxRateBp Int?    @map("tax_rate_bp")
  taxAmount BigInt  @default(0) @map("tax_amount") @db.BigInt

  totalAmount BigInt @map("total_amount") @db.BigInt

  invoice Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  unit    MeasurementUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  fuelEntry InvoiceFuelEntry?
  feedbacks ReviewFeedback[]

  /// مرجع FK ترکیبی ردیف سوخت — تضمین می‌کند ردیف تاریخ و ردیف مالی یک فاکتور باشند.
  @@unique([id, invoiceId])
  @@unique([invoiceId, rowNo])
  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoicePayment {
  invoiceId String @id @map("invoice_id") @db.Uuid

  paymentMethodId String            @map("payment_method_id") @db.Uuid
  methodKind      PaymentMethodKind @map("method_kind")

  /// حساب ذی‌نفع
  vendorBankAccountId  String? @map("vendor_bank_account_id") @db.Uuid
  /// شبا در لحظه ثبت snapshot می‌شود تا تغییر بعدی حساب، فاکتور تاریخی را عوض نکند.
  ibanSnapshot         String? @map("iban_snapshot") @db.VarChar(26)
  bankTitleSnapshot    String? @map("bank_title_snapshot") @db.VarChar(100)
  accountTitleSnapshot String? @map("account_title_snapshot") @db.VarChar(200)

  /// شناسه پرداخت به **فاکتور** تعلق دارد، نه به شبا (§۱۳.۱).
  paymentIdentifier String? @map("payment_identifier") @db.VarChar(100)
  /// قبض
  billIdentifier    String? @map("bill_identifier") @db.VarChar(100)
  /// تنخواه (تصمیم Q9)
  pettyCashHolderId String? @map("petty_cash_holder_id") @db.Uuid
  notes             String? @db.Text

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice           Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentMethod     PaymentMethod      @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  vendorBankAccount VendorBankAccount? @relation(fields: [vendorBankAccountId], references: [id], onDelete: SetNull)
  pettyCashHolder   User?              @relation("PettyCashHolder", fields: [pettyCashHolderId], references: [id], onDelete: SetNull)

  @@map("invoice_payments")
}

// ═══════════════════════ فاز ۴ — فاکتورهای اختصاصی ═══════════════════════
// مرجع: docs/05-invoice-types.md و معیار پذیرش فاز ۴.
//
// قاعده طراحی این بخش: **مبالغ فقط یک‌جا زندگی می‌کنند** — در `invoice_items`.
// جدول‌های زیر هیچ مبلغی را تکرار نمی‌کنند و تنها ویژگی‌های غیرمالی اختصاصی
// (مدرسه، ناحیه، نوع انشعاب، خودرو، نوع سوخت، ماه، روز) را نگه می‌دارند. اگر مبلغ
// در دو جا ذخیره می‌شد، دو منبع حقیقت داشتیم و واگرایی‌شان فقط زمان می‌خواست.
//
// همه عنوان‌ها در لحظه ثبت snapshot می‌شوند (ADR-0005): تغییر نام مدرسه یا پلاک
// خودرو، فاکتور تاریخی را عوض نمی‌کند.

/// جزئیات فاکتور انشعابات — یک ردیف به‌ازای هر فاکتور.
model InvoiceUtilityDetail {
  invoiceId String @id @map("invoice_id") @db.Uuid

  /// نسخه denormal خانواده فاکتور — **فقط** برای FK ترکیبی. مقدارش با CHECK دیتابیس
  /// به `UTILITY` قفل است، پس این ردیف هرگز به فاکتور سوخت یا عادی نمی‌چسبد.
  invoiceKind InvoiceKind @map("invoice_kind")

  schoolId            String @map("school_id") @db.Uuid
  schoolTitleSnapshot String @map("school_title_snapshot") @db.VarChar(200)

  /// ناحیه **مشتق از مدرسه** است؛ کلاینت آن را نمی‌فرستد و سرور از رکورد مدرسه
  /// می‌خواند (الزام «ناحیه خودکار» §۱۲ پرامپت).
  districtId            String @map("district_id") @db.Uuid
  districtTitleSnapshot String @map("district_title_snapshot") @db.VarChar(200)

  utilityTypeId            String @map("utility_type_id") @db.Uuid
  utilityTypeTitleSnapshot String @map("utility_type_title_snapshot") @db.VarChar(150)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice     Invoice     @relation(fields: [invoiceId, invoiceKind], references: [id, invoiceKind], onDelete: Cascade, onUpdate: Cascade)
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  district    District    @relation(fields: [districtId], references: [id], onDelete: Restrict)
  utilityType UtilityType @relation(fields: [utilityTypeId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, invoiceKind])
  @@index([schoolId])
  @@index([districtId])
  @@index([utilityTypeId])
  @@map("invoice_utility_details")
}

/// جزئیات فاکتور سوخت — یک ردیف به‌ازای هر فاکتور، به‌علاوه ماه شمسی فاکتور.
model InvoiceFuelDetail {
  invoiceId String @id @map("invoice_id") @db.Uuid

  /// همان نقش را برای سوخت دارد؛ با CHECK به `FUEL` قفل است.
  invoiceKind InvoiceKind @map("invoice_kind")

  vehicleId           String @map("vehicle_id") @db.Uuid
  plateNumberSnapshot String @map("plate_number_snapshot") @db.VarChar(50)

  /// نوع خودرو **مشتق از خودرو** است، نه ورودی کلاینت.
  vehicleTypeId            String @map("vehicle_type_id") @db.Uuid
  vehicleTypeTitleSnapshot String @map("vehicle_type_title_snapshot") @db.VarChar(150)

  fuelTypeId            String @map("fuel_type_id") @db.Uuid
  fuelTypeTitleSnapshot String @map("fuel_type_title_snapshot") @db.VarChar(100)

  /// ماه شمسی فاکتور؛ تاریخ هر ردیف از همین سال و ماه ساخته می‌شود.
  jalaliYear  Int @map("jalali_year")
  jalaliMonth Int @map("jalali_month")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice     Invoice     @relation(fields: [invoiceId, invoiceKind], references: [id, invoiceKind], onDelete: Cascade, onUpdate: Cascade)
  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Restrict)
  fuelType    FuelType    @relation(fields: [fuelTypeId], references: [id], onDelete: Restrict)

  entries InvoiceFuelEntry[]

  @@unique([invoiceId, invoiceKind])
  @@index([vehicleId])
  @@index([vehicleTypeId])
  @@index([fuelTypeId])
  @@index([jalaliYear, jalaliMonth])
  @@map("invoice_fuel_details")
}

/// روز سوخت‌گیری هر ردیف فاکتور سوخت.
///
/// یک‌به‌یک با `invoice_items` است و **مبلغ را تکرار نمی‌کند**؛ مبلغ همان
/// `invoice_items.unit_price` است. FK ترکیبی `(invoice_item_id, invoice_id)` تضمین
/// می‌کند ردیف تاریخ به فاکتوری جز فاکتور خودش نچسبد.
model InvoiceFuelEntry {
  id            String @id @default(uuid()) @db.Uuid
  invoiceId     String @map("invoice_id") @db.Uuid
  invoiceItemId String @unique @map("invoice_item_id") @db.Uuid

  /// روز ماه شمسی (۱ تا ۳۱)
  jalaliDay Int @map("jalali_day")

  /// تاریخ کامل که **سرور** از سال/ماه فاکتور و روز ردیف ساخته است.
  entryDate DateTime @map("entry_date") @db.Date

  fuelDetail  InvoiceFuelDetail @relation(fields: [invoiceId], references: [invoiceId], onDelete: Cascade)
  invoiceItem InvoiceItem       @relation(fields: [invoiceItemId, invoiceId], references: [id, invoiceId], onDelete: Cascade)

  /// یکتایی ردیف مالی روی همین زوج ستون — لازمه رابطه یک‌به‌یک با FK ترکیبی.
  @@unique([invoiceItemId, invoiceId])
  @@index([invoiceId, jalaliDay])
  @@map("invoice_fuel_entries")
}

// ═══════════════════════ فاز ۵ — بایگانی، فایل، نظارت ═══════════════════════
// مرجع: docs/03-erd.md §۴ و docs/12-file-storage-policy.md
//
// سه قاعده این بخش:
//  ۱. شماره و تاریخ سند فقط در `financial_documents` زندگی می‌کنند؛ `archive_metadata`
//     اطلاعات **فرایند** بایگانی را دارد، نه داده سند. دو منبع حقیقت، یعنی اختلاف.
//  ۲. فایل‌ها hard-delete نمی‌شوند: `deleted_at` تنها soft-delete پروژه است.
//  ۳. بازخورد ناظر **هرگز** حذف نمی‌شود؛ فقط وضعیتش عوض می‌شود و هر تغییر در
//     `review_feedback_status_history` می‌نشیند (معیار پذیرش ۷).

enum ArchiveStatus {
  RECEIVED
  IN_PROGRESS
  COMPLETED
}

enum AttachmentKind {
  SCAN
  OTHER
  REPORT_OUTPUT
}

enum AttachmentStatus {
  PENDING
  READY
  QUARANTINED
}

enum ScanStatus {
  SKIPPED
  PENDING
  CLEAN
  INFECTED
}

enum FeedbackStatus {
  OPEN
  ANSWERED
  RESOLVED
  REJECTED
}

enum FeedbackTargetKind {
  DOCUMENT
  STAD_META
  VENDOR
  INVOICE
  INVOICE_ITEM
  PAYMENT
  ARCHIVE
  TAX_REPORT
}

enum NotificationKind {
  DOCUMENT_SENT_TO_ARCHIVE
  DOCUMENT_ARCHIVED
  DOCUMENT_NEEDS_REVISION
  FEEDBACK_CREATED
  FEEDBACK_REPLIED
  FEEDBACK_RESOLVED
}

/// اطلاعات فرایند بایگانی یک سند — یک ردیف به‌ازای هر سند، از لحظه ارجاع.
model ArchiveMetadata {
  documentId String        @id @map("document_id") @db.Uuid
  status     ArchiveStatus @default(RECEIVED)

  notes String? @db.Text

  /// لحظه ورود به کارتابل بایگانی (ارجاع کارپردازی).
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  archivedById String?   @map("archived_by_id") @db.Uuid
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  document   FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  archivedBy User?             @relation("ArchiveCompletedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@map("archive_metadata")
}

/// فایل پیوست سند (اسکن و غیره).
model Attachment {
  id         String         @id @default(uuid()) @db.Uuid
  documentId String         @map("document_id") @db.Uuid
  kind       AttachmentKind @default(SCAN)

  /// کلید شیء در object storage — **سروری** ساخته می‌شود و نام کاربر در آن نیست.
  storageKey String @unique @map("storage_key") @db.VarChar(500)

  /// نام اصلی فقط **داده** است و هرگز در مسیر فایل یا کلید شیء استفاده نمی‌شود.
  originalFilename String @map("original_filename") @db.VarChar(255)

  /// MIME اعلامی کلاینت در برابر نوع تشخیص‌داده‌شده از محتوا — هر دو نگه داشته
  /// می‌شوند تا تلاش برای جعل، بعداً قابل بررسی باشد.
  declaredMime String @map("declared_mime") @db.VarChar(150)
  detectedMime String @map("detected_mime") @db.VarChar(150)
  typeKey      String @map("type_key") @db.VarChar(20)

  sizeBytes      BigInt @map("size_bytes") @db.BigInt
  checksumSha256 String @map("checksum_sha256") @db.Char(64)

  pageCount Int? @map("page_count")

  status     AttachmentStatus @default(PENDING)
  scanStatus ScanStatus       @default(SKIPPED) @map("scan_status")

  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// تنها soft-delete پروژه: فایل از UI حذف شده ولی ردپای حسابرسی باقی می‌ماند.
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById String?   @map("deleted_by_id") @db.Uuid

  document   FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User              @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedBy  User?             @relation("AttachmentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([documentId, deletedAt, createdAt])
  @@index([checksumSha256])
  @@map("attachments")
}

/// بازخورد ناظر روی سند یا یکی از اجزای آن.
model ReviewFeedback {
  id         String             @id @default(uuid()) @db.Uuid
  documentId String             @map("document_id") @db.Uuid
  targetKind FeedbackTargetKind @map("target_kind")

  /// هدف دقیق‌تر؛ بسته به `targetKind` پر می‌شود. قید سازگاری در migration است.
  invoiceId     String? @map("invoice_id") @db.Uuid
  invoiceItemId String? @map("invoice_item_id") @db.Uuid
  sectionKey    String? @map("section_key") @db.VarChar(100)

  body   String         @db.Text
  status FeedbackStatus @default(OPEN)

  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(3)

  document    FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  invoice     Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItem InvoiceItem?      @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("FeedbackCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  replies       ReviewFeedbackReply[]
  statusHistory ReviewFeedbackStatusHistory[]

  @@index([documentId, status, createdAt])
  @@index([status, createdAt])
  @@index([invoiceId])
  @@map("review_feedbacks")
}

/// پاسخ کارپردازی به یک بازخورد. پاسخ‌ها هم حذف نمی‌شوند.
model ReviewFeedbackReply {
  id         String @id @default(uuid()) @db.Uuid
  feedbackId String @map("feedback_id") @db.Uuid
  body       String @db.Text

  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  feedback  ReviewFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  createdBy User           @relation("FeedbackReplyBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([feedbackId, createdAt])
  @@map("review_feedback_replies")
}

/// تاریخچه کامل وضعیت بازخورد — بدون این، «رسیدگی شد» ادعایی بی‌سند است.
model ReviewFeedbackStatusHistory {
  id         String          @id @default(uuid()) @db.Uuid
  feedbackId String          @map("feedback_id") @db.Uuid
  fromStatus FeedbackStatus? @map("from_status")
  toStatus   FeedbackStatus  @map("to_status")
  note       String?         @db.Text

  actorId   String   @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  feedback ReviewFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  actor    User           @relation("FeedbackStatusActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([feedbackId, createdAt])
  @@map("review_feedback_status_history")
}

/// اعلان داخلی — بدون ایمیل و بدون سرویس بیرونی.
model Notification {
  id     String           @id @default(uuid()) @db.Uuid
  userId String           @map("user_id") @db.Uuid
  kind   NotificationKind

  title String  @db.VarChar(200)
  body  String? @db.Text

  documentId String? @map("document_id") @db.Uuid
  feedbackId String? @map("feedback_id") @db.Uuid

  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User               @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  document FinancialDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// کارتابل اعلان: خوانده‌نشده‌های همان کاربر، جدیدترین اول.
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// ═══════════════════════ فاز ۶ — گزارش‌گیری ═══════════════════════
// مرجع: docs/09-report-engine.md و docs/03-erd.md §۵
//
// سه قاعده‌ای که این بخش را از یک «صفحه گزارش» جدا می‌کند:
//  ۱. قالب **داده** است (JSONB)، نه کد؛ گزارش مالیات کد رندر اختصاصی ندارد.
//  ۲. نسخه منتشرشده تغییرناپذیر است، پس خروجی تاریخی با ویرایش قالب خراب نمی‌شود.
//  ۳. هر اجرا هم نسخه قالب و هم نسخه سند را ثبت می‌کند ⇒ بازتولید بیت‌به‌بیت.

enum ReportDefinitionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReportVersionStatus {
  DRAFT
  PUBLISHED
}

enum ReportRunStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ReportOutputFormat {
  HTML
  EXCEL
  PDF
}

/// نوع گزارش: دامنه داده‌ای که قالب‌های این نوع می‌توانند به آن دسترسی داشته باشند.
model ReportType {
  id     String @id @default(uuid()) @db.Uuid
  key    String @unique @db.VarChar(60)
  titleFa String @map("title_fa") @db.VarChar(200)

  /// کلید دامنه داده در Data Dictionary؛ فعلاً فقط `document`.
  dataScopeKey String @map("data_scope_key") @db.VarChar(60)

  /// گزارش سیستمی: قابل کپی و ویرایش، ولی نسخه اصلی به‌عنوان مرجع بازگشت می‌ماند.
  isSystem Boolean @default(false) @map("is_system")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  definitions ReportDefinition[]

  @@map("report_types")
}

model ReportDefinition {
  id           String                 @id @default(uuid()) @db.Uuid
  reportTypeId String                 @map("report_type_id") @db.Uuid
  name         String                 @db.VarChar(200)
  status       ReportDefinitionStatus @default(DRAFT)

  /// نسخه‌ای که اجرا از آن انجام می‌شود؛ همیشه یک نسخه PUBLISHED.
  currentVersionId String? @unique @map("current_version_id") @db.Uuid

  isSystem    Boolean @default(false) @map("is_system")
  createdById String? @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reportType     ReportType     @relation(fields: [reportTypeId], references: [id], onDelete: Restrict)
  createdBy      User?          @relation("ReportDefinitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  currentVersion ReportVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ReportVersion[] @relation("DefinitionVersions")
  runs           ReportRun[]

  @@index([reportTypeId, status])
  @@map("report_definitions")
}

/// نسخه قالب. پس از PUBLISHED شدن **هرگز** ویرایش نمی‌شود.
model ReportVersion {
  id           String              @id @default(uuid()) @db.Uuid
  definitionId String              @map("definition_id") @db.Uuid
  versionNo    Int                 @map("version_no")
  status       ReportVersionStatus @default(DRAFT)

  /// نسخه schema قالب؛ قالب با نسخه ناشناخته اجرا نمی‌شود.
  templateSchemaVersion Int  @default(1) @map("template_schema_version")
  template              Json

  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  definition        ReportDefinition  @relation("DefinitionVersions", fields: [definitionId], references: [id], onDelete: Cascade)
  createdBy         User?             @relation("ReportVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  currentOfDefinition ReportDefinition? @relation("CurrentVersion")
  runs              ReportRun[]

  @@unique([definitionId, versionNo])
  /// ستون فقرات FK ترکیبی: نسخه جاری یک قالب باید نسخه **همان** قالب باشد.
  @@unique([id, definitionId])
  @@map("report_versions")
}

/// یک اجرای گزارش. خروجی فایلی به `attachments` وصل می‌شود.
model ReportRun {
  id           String             @id @default(uuid()) @db.Uuid
  definitionId String             @map("definition_id") @db.Uuid
  versionId    String             @map("version_id") @db.Uuid
  documentId   String             @map("document_id") @db.Uuid

  /// نسخه سند در لحظه اجرا — بدون آن، بازتولید خروجی تاریخی ممکن نیست.
  documentRevisionId String? @map("document_revision_id") @db.Uuid

  params       Json               @default("{}")
  status       ReportRunStatus    @default(PENDING)
  outputFormat ReportOutputFormat
  rowCount     Int?               @map("row_count")
  durationMs   Int?               @map("duration_ms")
  errorMessage String?            @map("error_message") @db.Text

  requestedById String   @map("requested_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  definition ReportDefinition  @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version    ReportVersion     @relation(fields: [versionId], references: [id], onDelete: Restrict)
  document   FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requestedBy User             @relation("ReportRunRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@index([requestedById, createdAt])
  @@map("report_runs")
}

/// نوع کالای یک فروشنده **در یک سند**.
///
/// کلید ترکیبی `(document_id, vendor_id)` است نه فقط فروشنده: یک فروشنده در سندهای
/// مختلف نوع کالای متفاوت دارد (docs/03-erd.md §۵).
model DocumentVendorProductType {
  documentId    String @map("document_id") @db.Uuid
  vendorId      String @map("vendor_id") @db.Uuid
  productTypeId String @map("product_type_id") @db.Uuid

  setById String   @map("set_by") @db.Uuid
  setAt   DateTime @default(now()) @map("set_at") @db.Timestamptz(3)

  document    FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  vendor      Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productType ProductType       @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  setBy       User              @relation("ProductTypeSetBy", fields: [setById], references: [id], onDelete: Cascade)

  @@id([documentId, vendorId])
  @@index([vendorId])
  @@map("document_vendor_product_types")
}

/// پیشنهاد نوع کالا برای یک فروشنده، بر اساس انتخاب‌های قبلی.
///
/// چرا جدول جدا و نه شمارش لحظه‌ای روی جدول بالا: پیشنهاد باید مرتب‌سازی‌شده و سریع
/// باشد و با حذف یک سند هم از بین نرود؛ «این فروشنده معمولاً انشعاب برق می‌فروشد»
/// دانشی است که به یک سند بسته نیست.
model VendorProductTypeSuggestion {
  vendorId      String @map("vendor_id") @db.Uuid
  productTypeId String @map("product_type_id") @db.Uuid
  useCount      Int    @default(0) @map("use_count")

  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)

  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  productType ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@id([vendorId, productTypeId])
  @@index([vendorId, useCount])
  @@map("vendor_product_type_suggestions")
}
