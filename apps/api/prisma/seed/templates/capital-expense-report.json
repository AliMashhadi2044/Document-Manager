{
  "schemaVersion": 1,
  "reportTypeKey": "EXPENSE_BREAKDOWN_CAPITAL",
  "titleFa": "صورت ریز هزینه‌های عمرانی انجام شده",
  "page": {
    "size": "A4",
    "orientation": "landscape",
    "margins": {
      "top": 12,
      "bottom": 12,
      "inlineStart": 10,
      "inlineEnd": 10
    },
    "direction": "rtl"
  },
  "styles": {
    "fontFamily": "Vazirmatn, Tahoma, sans-serif",
    "baseFontSizePt": 9,
    "headingFontSizePt": 13,
    "tableFontSizePt": 8,
    "borderWidthPx": 1,
    "borderColor": "#333333",
    "textColor": "#000000",
    "mutedTextColor": "#555555"
  },
  "header": {
    "repeatOnEveryPage": true,
    "blocks": [
      {
        "id": "org-name",
        "type": "text",
        "text": "{{organization.name}}",
        "align": "center",
        "bold": true,
        "fontSizePt": 13
      },
      {
        "id": "report-title",
        "type": "text",
        "text": "صورت ریز هزینه‌های عمرانی انجام شده",
        "align": "center",
        "bold": true,
        "fontSizePt": 12
      },
      {
        "id": "document-line",
        "type": "text",
        "text": "شرح سند: {{document.title}} — سال مالی {{document.fiscalYear}}",
        "align": "center",
        "bold": false
      },
      {
        "id": "document-number-line",
        "type": "text",
        "text": "شماره سند: {{document.documentNumber}} — تاریخ سند: {{document.documentDateJalali}}",
        "align": "center",
        "bold": false,
        "visibleWhen": {
          "k": "not",
          "of": {
            "k": "empty",
            "of": {
              "k": "var",
              "path": "document.documentNumber"
            }
          }
        }
      },
      {
        "id": "header-divider",
        "type": "divider"
      }
    ]
  },
  "body": [
    {
      "id": "expense-table",
      "type": "table",
      "dataSource": "document.capitalExpenses",
      "minRows": 18,
      "sortBy": [],
      "pagination": {
        "repeatHeaderOnNewPage": true,
        "avoidRowBreak": true
      },
      "totalsRow": {
        "enabled": true,
        "labelFa": "جمع کل",
        "cells": {
          "chapter": "sum",
          "total": "sum"
        }
      },
      "columns": [
        {
          "key": "rowNo",
          "titleFa": "ردیف",
          "width": {
            "unit": "mm",
            "value": 10
          },
          "align": "center",
          "value": {
            "k": "var",
            "path": "row.index"
          },
          "format": {
            "kind": "integer",
            "persianDigits": true,
            "thousandSeparator": false,
            "decimals": 0,
            "emptyText": ""
          },
          "rowNumber": true
        },
        {
          "key": "description",
          "titleFa": "شرح",
          "width": {
            "unit": "mm",
            "value": 56
          },
          "align": "start",
          "value": {
            "k": "var",
            "path": "row.description"
          },
          "format": {
            "kind": "text",
            "persianDigits": false,
            "thousandSeparator": false,
            "decimals": 0,
            "emptyText": ""
          }
        },
        {
          "key": "chapter",
          "titleFa": "فصل",
          "repeatFor": {
            "over": "document.capitalChapters",
            "keyFrom": "key",
            "titleFrom": "title",
            "subtitleFrom": "code",
            "maxColumns": 10
          },
          "width": {
            "unit": "mm",
            "value": 18
          },
          "align": "end",
          "value": {
            "k": "if",
            "cond": {
              "k": "cmp",
              "op": "eq",
              "args": [
                {
                  "k": "var",
                  "path": "row.chapterKey"
                },
                {
                  "k": "var",
                  "path": "column.key"
                }
              ]
            },
            "then": {
              "k": "var",
              "path": "row.total"
            },
            "else": {
              "k": "const",
              "type": "text",
              "v": ""
            }
          },
          "format": {
            "kind": "currency",
            "persianDigits": true,
            "thousandSeparator": true,
            "decimals": 0,
            "emptyText": ""
          }
        },
        {
          "key": "total",
          "titleFa": "جمع",
          "width": {
            "unit": "mm",
            "value": 30
          },
          "align": "end",
          "value": {
            "k": "var",
            "path": "row.total"
          },
          "format": {
            "kind": "currency",
            "persianDigits": true,
            "thousandSeparator": true,
            "decimals": 0,
            "emptyText": ""
          }
        }
      ]
    }
  ],
  "footer": {
    "repeatOnEveryPage": false,
    "blocks": [
      {
        "id": "footer-space",
        "type": "spacer",
        "heightMm": 6
      },
      {
        "id": "signatures",
        "type": "signatureRow",
        "blocks": [
          {
            "id": "sign-procurement-lead",
            "type": "signature",
            "signatoryRoleKey": "PROCUREMENT_LEAD",
            "align": "center",
            "spaceMm": 18
          },
          {
            "id": "sign-review-lead",
            "type": "signature",
            "signatoryRoleKey": "REVIEW_LEAD",
            "align": "center",
            "spaceMm": 18
          }
        ]
      }
    ]
  }
}
